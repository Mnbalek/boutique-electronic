    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
